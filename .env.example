# Server-side Gemini API key for the private chat endpoint.
# In Replit, set AI_API in Secrets. Locally, use an untracked .env.local file.
# Never prefix this key with VITE_ or place it in frontend code.
# AI_API=<your Gemini API key>
# Optional model override (defaults to gemini-3.8-flash):
# GEMINI_MODEL=gemini-3.8-flash

# CURSER: Set to "true" to enable the interactive Virtual Cursor Touchpad system for testing
CURSER="true"
VITE_CURSER="true"
